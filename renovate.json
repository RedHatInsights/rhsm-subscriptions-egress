{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "tekton": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* * * * *"]
  },
  "packageRules": [
    {
      "description": "Do not open MintMaker PRs for pip lockfile (managed via scripts/refresh-requirements.sh).",
      "matchManagers": ["pip_requirements", "pip_setup", "pep621", "poetry"],
      "enabled": false
    }
  ]
}
